<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <Style src="../USS/theme.uss" />
  <ui:ScrollView name="categories-root" class="page" mode="Vertical">
    <ui:VisualElement class="page-header accounts-header">
      <ui:VisualElement>
        <ui:Label text="Catégories" class="page-title" />
        <ui:Label text="Créez, renommez ou archivez vos catégories et sous-catégories." class="page-subtitle" />
      </ui:VisualElement>
      <ui:Button name="new-category-button" text="+ Nouvelle catégorie" class="primary-button" />
    </ui:VisualElement>

    <ui:VisualElement name="category-form-card" class="card form-card" style="display: none;">
      <ui:Label name="form-title" text="Nouvelle catégorie" class="card-title" />

      <ui:VisualElement class="form-row">
        <ui:Label text="Nom" class="form-label" />
        <ui:TextField name="form-name" class="form-field" />
      </ui:VisualElement>

      <ui:VisualElement name="form-type-row" class="form-row">
        <ui:Label text="Type" class="form-label" />
        <ui:DropdownField name="form-type" class="form-field" />
      </ui:VisualElement>
      <ui:VisualElement name="form-type-readonly-row" class="form-row" style="display: none;">
        <ui:Label text="Type" class="form-label" />
        <ui:Label name="form-type-readonly" text="—" class="form-readonly-value" />
      </ui:VisualElement>

      <ui:VisualElement name="form-parent-row" class="form-row">
        <ui:Label text="Catégorie parente (facultatif)" class="form-label" />
        <ui:DropdownField name="form-parent" class="form-field" />
      </ui:VisualElement>

      <ui:Label name="form-system-note" text="Catégorie système : le nom reste modifiable, mais elle ne peut pas être archivée." class="card-caption" style="display: none;" />

      <ui:VisualElement class="form-actions">
        <ui:Button name="form-archive-button" text="Archiver" class="danger-button" style="display: none;" />
        <ui:Button name="form-cancel-button" text="Annuler" class="secondary-button" />
        <ui:Button name="form-submit-button" text="Créer" class="primary-button" />
      </ui:VisualElement>

      <ui:Label name="form-error" text="" class="form-error" style="display: none;" />
    </ui:VisualElement>

    <ui:VisualElement name="categories-card" class="card">
      <ui:VisualElement class="card-header">
        <ui:Label text="Toutes les catégories" class="card-title" />
        <ui:Button name="new-category-button-list" text="+ Nouvelle catégorie" class="secondary-button" />
      </ui:VisualElement>
      <ui:Label name="categories-empty" text="Aucune catégorie pour l'instant." class="empty-state" />
      <ui:MultiColumnListView name="categories-list-view" class="transactions-table" style="display: none;" />
    </ui:VisualElement>
  </ui:ScrollView>
</ui:UXML>
