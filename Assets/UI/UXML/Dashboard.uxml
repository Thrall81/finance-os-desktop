<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <Style src="../USS/theme.uss" />
  <ui:ScrollView name="dashboard-root" class="page" mode="Vertical">
    <ui:VisualElement name="dashboard-header" class="page-header">
      <ui:VisualElement>
        <ui:Label text="Tableau de bord" class="page-title" />
        <ui:Label name="account-name-label" text="—" class="page-subtitle" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="kpi-row" class="kpi-row">
      <ui:VisualElement class="kpi-card">
        <ui:Label text="Solde disponible" class="kpi-label" />
        <ui:Label name="kpi-available-value" text="—" class="kpi-value" />
      </ui:VisualElement>
      <ui:VisualElement class="kpi-card">
        <ui:Label text="Solde prévu en fin de mois" class="kpi-label" />
        <ui:Label name="kpi-endofmonth-value" text="—" class="kpi-value" />
      </ui:VisualElement>
      <ui:VisualElement class="kpi-card">
        <ui:Label text="Point bas prévisionnel" class="kpi-label" />
        <ui:Label name="kpi-lowest-value" text="—" class="kpi-value" />
        <ui:Label name="kpi-lowest-date" text="—" class="kpi-context" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="cashflow-card" class="card">
      <ui:VisualElement class="card-header">
        <ui:Label text="Courbe de trésorerie" class="card-title" />
      </ui:VisualElement>
      <ui:Label text="Trait plein : réel. Pointillé : prévu. Marqueur : point bas." class="card-caption" />
      <ui:VisualElement name="cashflow-chart-container" class="chart" />
    </ui:VisualElement>

    <ui:VisualElement name="donut-card" class="card">
      <ui:VisualElement class="card-header">
        <ui:Label text="Répartition des dépenses" class="card-title" />
      </ui:VisualElement>
      <ui:Label text="Dépenses du mois en cours par catégorie, triées de la plus grande à la plus petite." class="card-caption" />
      <ui:Label name="donut-empty" text="Aucune dépense ce mois-ci." class="empty-state" />
      <ui:VisualElement name="donut-row" class="donut-row">
        <ui:VisualElement name="donut-chart-container" class="donut-container" />
        <ui:VisualElement name="donut-legend" class="donut-legend" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="verification-card" class="card">
      <ui:VisualElement class="card-header">
        <ui:Label text="Opérations à vérifier" class="card-title" />
        <ui:Label name="verification-count" text="0" class="badge" />
      </ui:VisualElement>
      <ui:Label name="verification-empty" text="Rien à vérifier pour l'instant." class="empty-state" />
      <ui:VisualElement name="verification-list" class="list" />
    </ui:VisualElement>
  </ui:ScrollView>
</ui:UXML>
