<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <Style src="../USS/theme.uss" />
  <ui:VisualElement name="shell-root" class="shell-root">
    <ui:VisualElement name="sidebar" class="sidebar">
      <ui:Label text="Finance OS" class="sidebar-title" />
      <ui:VisualElement name="nav-list" class="nav-list">
        <ui:Button name="nav-dashboard" text="Tableau de bord" class="nav-item" />
        <ui:Button name="nav-accounts" text="Comptes" class="nav-item" />
        <ui:Button name="nav-transactions" text="Transactions" class="nav-item" />
        <ui:Button name="nav-recurring-operations" text="Opérations récurrentes" class="nav-item" />
        <ui:Button name="nav-forecasts" text="Prévisions" class="nav-item" />
        <ui:Button name="nav-budgets" text="Budget" class="nav-item" />
        <ui:Button name="nav-categories" text="Catégories" class="nav-item" />
        <ui:Button name="nav-settings" text="Paramètres" class="nav-item" />
      </ui:VisualElement>
      <ui:VisualElement class="sidebar-spacer" />
      <ui:Button name="quit-button" text="Quitter" class="nav-item nav-item-quit" />
    </ui:VisualElement>
    <ui:VisualElement name="content-area" class="content-area" />
    <ui:VisualElement name="update-ready-overlay" class="modal-overlay" style="display: none;">
      <ui:VisualElement class="modal-card">
        <ui:Label text="Mise à jour disponible" class="card-title" />
        <ui:Label name="update-ready-message" text="" class="modal-message" />
        <ui:VisualElement class="form-actions">
          <ui:Button name="update-later-button" text="Plus tard" class="secondary-button" />
          <ui:Button name="update-install-button" text="Installer et redémarrer" class="primary-button" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="changelog-overlay" class="modal-overlay" style="display: none;">
      <ui:VisualElement class="modal-card changelog-card">
        <ui:Label text="Nouveautés" class="card-title" />
        <ui:ScrollView name="changelog-list" class="changelog-list" mode="Vertical" />
        <ui:VisualElement class="form-actions">
          <ui:Button name="changelog-close-button" text="Fermer" class="primary-button" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
