<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <Style src="../USS/theme.uss" />
  <ui:VisualElement name="shell-root" class="shell-root">
    <ui:VisualElement name="sidebar" class="sidebar">
      <ui:Label text="Finance OS" class="sidebar-title" />
      <ui:VisualElement name="nav-list" class="nav-list">
        <ui:Button name="nav-dashboard" text="Tableau de bord" class="nav-item" />
        <ui:Button name="nav-accounts" text="Comptes" class="nav-item" />
        <ui:Button name="nav-transactions" text="Transactions" class="nav-item" />
        <ui:Button name="nav-recurring-operations" text="Opérations récurrentes" class="nav-item" />
        <ui:Button name="nav-forecasts" text="Prévisions" class="nav-item" />
        <ui:Button name="nav-budgets" text="Budget" class="nav-item" />
        <ui:Button name="nav-categories" text="Catégories" class="nav-item" />
        <ui:Button name="nav-settings" text="Paramètres" class="nav-item" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="content-area" class="content-area" />
  </ui:VisualElement>
</ui:UXML>
