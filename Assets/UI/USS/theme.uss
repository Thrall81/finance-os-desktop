/* Design tokens. Light theme is the default; dark theme lives in the .theme-dark block below
   (ADR-135), toggled by ShellController.SetTheme — see docs/07-Interface.md.
   Typography: Spectral for the wordmark and every heading (page/card title), IBM Plex Sans for
   the rest of the interface (the base font, set once on .shell-root and inherited), IBM Plex
   Mono for every money/date display — see docs/07-Interface.md §8bis and
   Assets/Fonts/THIRD-PARTY-NOTICES.md for provenance. Real Bold files are used directly wherever
   one is vendored (never -unity-font-style: bold to synthesize it from a Regular file). */

.shell-root {
    --color-bg: #F5F4EE;
    --color-surface: #FFFFFF;
    --color-border: #E1DFD3;
    --color-ink-900: #171B22;
    --color-ink-600: #565C66;
    --color-ink-400: #868C94;
    --color-accent: #2E3A59;
    --color-gold: #A9762F;
    --color-gold-soft: #F3E7D3;
    --color-danger: #A3402F;
    --color-on-accent: #FFFFFF;

    flex-grow: 1;
    flex-direction: row;
    background-color: var(--color-bg);
    -unity-font-definition: url("../../Fonts/IBMPlexSans-Regular.ttf");
}

/* Dark theme (ADR-135) — same ten tokens redefined, applied by toggling this class on
   .shell-root itself (ShellController.SetTheme) rather than a media query, since UI Toolkit has
   no OS theme detection here and the user picks explicitly in Paramètres. Values match the
   dashboard mockup's own light/dark pairs (docs/mockups/dashboard.html) where a token exists
   there; --color-danger maps to its --negative, and --color-on-accent has no mockup equivalent
   (needed here specifically so .primary-button's white text stays readable once --color-accent
   itself turns light in dark mode). Painter2D chart colors are plain C# values, not CSS custom
   properties, so they can't read these — see LineChartElement.DarkTheme and its siblings instead. */
.shell-root.theme-dark {
    --color-bg: #14171C;
    --color-surface: #1A1E24;
    --color-border: #2B2F37;
    --color-ink-900: #EDEEF0;
    --color-ink-600: #ABB0B8;
    --color-ink-400: #767C86;
    --color-accent: #8FA0D6;
    --color-gold: #D9A94F;
    --color-gold-soft: #3A2E18;
    --color-danger: #E0876A;
    --color-on-accent: #171B22;
}

.sidebar {
    width: 220px;
    flex-shrink: 0;
    background-color: var(--color-surface);
    border-right-width: 1px;
    border-right-color: var(--color-border);
    padding: 20px 14px;
}

/* Pushes the Quitter button to the bottom of the sidebar, always visible from any screen
   regardless of how tall .nav-list grows — a real fix reported after actually testing the
   built app: the very first build had no titlebar/close button at all (ADR-138), and even once
   a real window exists, a clearly discoverable in-app quit action is worth keeping either way. */
.sidebar-spacer {
    flex-grow: 1;
}

.nav-item-quit {
    border-top-width: 1px;
    border-top-color: var(--color-border);
    border-radius: 0;
    margin: 8px 0 0 0;
    padding-top: 13px;
    color: var(--color-ink-400);
}

.nav-item-quit:hover {
    background-color: var(--color-bg);
    color: var(--color-danger);
}

/* The update-ready confirmation (ADR-139) — a direct child of .shell-root so it can cover the
   whole window (sidebar included), not just .content-area. UI Toolkit elements are positioned
   relative by default (unlike raw CSS's static default), so no extra rule is needed on the
   parent for this absolute overlay to size against it correctly. */
.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(23, 27, 34, 0.45);
    align-items: center;
    justify-content: center;
}

.modal-card {
    width: 380px;
    background-color: var(--color-surface);
    border-radius: 10px;
    padding: 24px;
}

.modal-message {
    font-size: 13px;
    color: var(--color-ink-600);
    margin-top: 8px;
    margin-bottom: 20px;
    white-space: normal;
}

.sidebar-title {
    font-size: 16px;
    -unity-font-definition: url("../../Fonts/Spectral-Bold.ttf");
    color: var(--color-ink-900);
    margin-bottom: 18px;
    margin-left: 6px;
}

.nav-list {
    flex-direction: column;
}

.nav-item {
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
    padding: 9px 10px;
    margin: 0 0 4px 0;
    font-size: 13px;
    color: var(--color-ink-600);
}

.nav-item:hover {
    background-color: var(--color-bg);
}

.nav-item-active {
    background-color: var(--color-gold-soft);
    color: var(--color-gold);
    -unity-font-definition: url("../../Fonts/IBMPlexSans-Bold.ttf");
}

.content-area {
    flex-grow: 1;
}

/* Padding lives on the ScrollView element itself, so the vertical scroller (a sibling of the
   content inside the same padded box, not outside it) eats into the right-hand gutter — the
   visual gap on the right ends up wider than the left's clean 28px by roughly the scrollbar's own
   width. Approximated here by trimming the right padding rather than restructuring every screen's
   UXML with an extra wrapper; the scrollbar itself is also narrowed below (ADR-142) so the
   approximation needs less precision to look right. Still an approximation — needs a real
   screenshot to fine-tune further, same as every other visual change this project makes. */
.page {
    flex-grow: 1;
    padding: 24px 16px 24px 28px;
}

/* A visible, boxy scrollbar (Unity's default runtime theme) reads as heavy against this app's
   otherwise flat, borderless-until-hovered aesthetic, and its low/high step-buttons are dated —
   restyled to a slim, theme-aware, mostly-invisible-until-needed thumb instead. Scoped under
   .unity-scroll-view__vertical-scroller (not the bare Unity class names) so this can't
   accidentally restyle a Slider used for something else, if one is ever added. Class names
   confirmed against Unity's own ScrollView/Scroller/Slider manual pages, not guessed — same
   discipline as ADR-116 after DLL-grepping and blind introspection both failed there. */
.unity-scroll-view__vertical-scroller {
    width: 10px;
}

.unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: var(--color-border);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
    left: 2px;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover {
    background-color: var(--color-ink-400);
}

.page-header {
    min-height: 60px;
    margin-bottom: 24px;
}

.page-title {
    font-size: 22px;
    -unity-font-definition: url("../../Fonts/Spectral-Bold.ttf");
    color: var(--color-ink-900);
}

.page-subtitle {
    font-size: 13px;
    color: var(--color-ink-400);
    margin-top: 6px;
}

.kpi-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.kpi-card {
    flex-grow: 1;
    flex-basis: 190px;
    min-width: 190px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
    padding: 14px 16px 18px 16px;
    margin-right: 12px;
    margin-bottom: 12px;
}

/* UI Toolkit's USS does not support the structural pseudo-class :last-child (web-CSS only) —
   confirmed by a real "Unknown pseudo class" warning, not assumed. A small unused trailing
   margin after the last card is harmless, so every card just keeps the same margin-right. */

.kpi-label {
    font-size: 12px;
    color: var(--color-ink-600);
    margin-bottom: 6px;
}

.kpi-value {
    font-size: 22px;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Bold.ttf");
    color: var(--color-ink-900);
    margin-bottom: 4px;
}

.kpi-context {
    font-size: 11px;
    color: var(--color-ink-400);
    margin-top: 10px;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

/* margin-bottom here, not per-screen: consecutive top-level .card sections had no gap at all
   between them (only .kpi-row's own margin-bottom gave any visible spacing above the first card),
   so screens read as unevenly spaced depending on which section happened to sit next to which —
   real user feedback, not a guess. .form-card (below) still wins this property for a form's own
   card via source order, so create/edit forms keep their own distinct spacing. */
.card {
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
    padding: 16px 18px;
    margin-bottom: 24px;
}

.card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 24px;
    margin-bottom: 20px;
}

.card-title {
    font-size: 15px;
    -unity-font-definition: url("../../Fonts/Spectral-Bold.ttf");
    color: var(--color-ink-900);
}

/* An explanatory line under a card's own title (not to be confused with .page-subtitle, which
   sits tight under the big page title and is deliberately closer — reusing .page-subtitle here
   read as "too close to the title" once real text metrics were involved, see ADR-116). */
.card-caption {
    font-size: 12px;
    color: var(--color-ink-400);
    margin-top: 4px;
    margin-bottom: 14px;
}

.badge {
    font-size: 11px;
    padding: 2px 8px;
    background-color: var(--color-gold-soft);
    color: var(--color-gold);
    border-radius: 20px;
}

.badge-muted {
    font-size: 11px;
    padding: 2px 8px;
    background-color: var(--color-border);
    color: var(--color-ink-600);
    border-radius: 20px;
}

.empty-state {
    font-size: 13px;
    color: var(--color-ink-400);
}

.list {
    flex-direction: column;
}

.verification-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.verification-row-label {
    font-size: 13px;
    color: var(--color-ink-900);
    flex-grow: 1;
}

.verification-row-date {
    font-size: 11px;
    color: var(--color-ink-400);
    margin-top: 2px;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.verification-row-amount {
    font-size: 13px;
    color: var(--color-ink-900);
    -unity-text-align: middle-right;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.upcoming-row-right {
    flex-direction: column;
    align-items: flex-end;
}

.upcoming-row-badge {
    margin-top: 4px;
}

.budget-summary-row {
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.budget-summary-top {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.budget-summary-name {
    font-size: 13px;
    color: var(--color-ink-900);
}

.budget-summary-figures {
    font-size: 13px;
    color: var(--color-ink-600);
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.budget-summary-bar-track {
    height: 6px;
    border-radius: 3px;
    background-color: var(--color-border);
    overflow: hidden;
}

.budget-summary-bar-fill {
    height: 6px;
    background-color: var(--color-accent);
}

.budget-summary-bar-fill-over {
    background-color: var(--color-danger);
}

.budget-summary-note {
    font-size: 11px;
    color: var(--color-ink-400);
    margin-top: 4px;
}

.budget-summary-note-over {
    color: var(--color-danger);
}

.alert-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.alert-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: var(--color-gold);
}

.alert-dot-severe {
    background-color: var(--color-danger);
}

.alert-message {
    font-size: 13px;
    color: var(--color-ink-900);
    flex-grow: 1;
}

.accounts-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.primary-button {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    border-width: 0;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

.secondary-button {
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-ink-600);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

.danger-button {
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-danger);
    border-width: 1px;
    border-color: var(--color-danger);
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

.form-card {
    margin-bottom: 16px;
}

.form-row {
    margin-bottom: 30px;
}

.form-label {
    font-size: 12px;
    color: var(--color-ink-600);
    margin-bottom: 4px;
}

.form-field {
    max-width: 360px;
}

.form-error {
    font-size: 12px;
    color: var(--color-danger);
    margin-bottom: 8px;
}

.form-warning {
    font-size: 12px;
    color: var(--color-gold);
    margin-bottom: 8px;
}

.form-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

/* Onboarding-only: a real reported point of confusion — "Ajouter ce compte"/"Ajouter" (the
   expected immediate action after filling the form) and "Précédent"/"Suivant" (step navigation)
   sat close enough together, especially with an empty list between them adding no visible gap,
   that testers routinely clicked the navigation button by reflex instead. A border-top plus real
   margin makes the navigation row read as a clearly separate group regardless of list content. */
.onboarding-nav-actions {
    margin-top: 24px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.onboarding-row-remove {
    margin: 0 0 0 12px;
    padding: 4px 10px;
    font-size: 11px;
}

/* ADR-145 (essai) : un Button stylé pour ressembler à un champ de saisie, pas à un bouton — texte
   aligné à gauche, fond/bordure repris des tokens existants — plutôt qu'un TextField, pour
   garantir que le clic ouvrant le calendrier App UI se déclenche de façon fiable (Button.clicked
   est éprouvé partout ailleurs dans ce projet ; un événement de clic générique sur un élément
   arbitraire ne l'a jamais été ici, aucun panel réel pour le vérifier). */
.date-field-trigger {
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--color-ink-900);
    -unity-text-align: middle-left;
}

.form-actions > Button {
    margin-left: 8px;
}

.account-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.account-row:hover {
    background-color: var(--color-bg);
}

.account-row-name {
    font-size: 13px;
    color: var(--color-ink-900);
}

.account-row-meta {
    font-size: 11px;
    color: var(--color-ink-400);
    margin-top: 2px;
}

.account-row-balance {
    font-size: 13px;
    color: var(--color-ink-900);
    -unity-text-align: middle-right;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.account-row-archived {
    opacity: 0.55;
}

.filter-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.filter-row > .form-label {
    margin-bottom: 0;
    margin-right: 8px;
}

.filter-row > .form-field {
    width: 220px;
}

.filters-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    margin-top: 4px;
}

.filter-group {
    flex-direction: column;
    margin-right: 16px;
    margin-bottom: 12px;
}

.filter-group > .form-label {
    margin-bottom: 4px;
}

.filter-group > .form-field {
    width: 160px;
}

.filter-group-wide > .form-field {
    width: 260px;
}

.form-readonly-value {
    font-size: 13px;
    color: var(--color-ink-600);
}

.form-row-inline {
    flex-direction: row;
    align-items: center;
}

/* Unity's Toggle control never had a project rule that actually matched anything — the first
   attempt at this fix (commit dc9b287) targeted .unity-toggle__text, a class that does not exist
   on this control in this Unity version. Confirmed via the UI Toolkit Debugger (Window > UI
   Toolkit > Debugger > Pick Element): the real class list on a Toggle's label is
   unity-text-element, unity-label, unity-base-field__label, unity-toggle__label — same "Unity
   composes BEM class strings at runtime, verify rather than assume" lesson as the
   MultiColumnListView header classes. The label defaulted to Unity's built-in runtime theme
   color, readable by coincidence on the light background but invisible (and, once any of it did
   show through, a dim blue when checked) against the dark one. */
.unity-toggle__label {
    color: var(--color-ink-900);
}

.field-suggested > .unity-base-field__input {
    background-color: var(--color-gold-soft);
}

.transactions-table {
    flex-grow: 1;
    min-height: 220px;
    max-height: 400px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    -unity-font-style: normal;
    color: var(--color-ink-900);
    font-size: 13px;
}

.amount-negative {
    color: var(--color-danger);
}

/* Table date cells have no other dedicated class (unlike amount cells, which already reuse
   .account-row-balance) — applied directly in C# wherever a MultiColumnListView builds a date
   column. */
.cell-mono {
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.chart {
    height: 200px;
    margin-bottom: 4px;
}

.chart-axis-label {
    font-size: 10px;
    color: var(--color-ink-400);
    -unity-text-align: upper-center;
    white-space: normal;
}

.donut-row {
    flex-direction: row;
    align-items: center;
}

.donut-container {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    margin-right: 20px;
}

.donut-legend {
    flex-grow: 1;
}

.donut-legend-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.donut-legend-swatch {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 8px;
    flex-shrink: 0;
}

.donut-legend-name {
    flex-grow: 1;
    font-size: 13px;
}

.donut-legend-value {
    font-size: 13px;
    color: var(--color-ink-600);
    -unity-text-align: middle-right;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.chart-tooltip {
    background-color: var(--color-ink-900);
    color: var(--color-surface);
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 4px;
    white-space: normal;
}
