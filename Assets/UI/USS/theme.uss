/* Design tokens. Light theme only for this first pass — see docs/07-Interface.md.
   Typography: Spectral for the wordmark and every heading (page/card title), IBM Plex Sans for
   the rest of the interface (the base font, set once on .shell-root and inherited), IBM Plex
   Mono for every money/date display — see docs/07-Interface.md §8bis and
   Assets/Fonts/THIRD-PARTY-NOTICES.md for provenance. Real Bold files are used directly wherever
   one is vendored (never -unity-font-style: bold to synthesize it from a Regular file). */

.shell-root {
    --color-bg: #F5F4EE;
    --color-surface: #FFFFFF;
    --color-border: #E1DFD3;
    --color-ink-900: #171B22;
    --color-ink-600: #565C66;
    --color-ink-400: #868C94;
    --color-accent: #2E3A59;
    --color-gold: #A9762F;
    --color-gold-soft: #F3E7D3;
    --color-danger: #A3402F;

    flex-grow: 1;
    flex-direction: row;
    background-color: var(--color-bg);
    -unity-font-definition: url("../../Fonts/IBMPlexSans-Regular.ttf");
}

.sidebar {
    width: 220px;
    flex-shrink: 0;
    background-color: var(--color-surface);
    border-right-width: 1px;
    border-right-color: var(--color-border);
    padding: 20px 14px;
}

.sidebar-title {
    font-size: 16px;
    -unity-font-definition: url("../../Fonts/Spectral-Bold.ttf");
    color: var(--color-ink-900);
    margin-bottom: 18px;
    margin-left: 6px;
}

.nav-list {
    flex-direction: column;
}

.nav-item {
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
    padding: 9px 10px;
    margin: 0 0 4px 0;
    font-size: 13px;
    color: var(--color-ink-600);
}

.nav-item:hover {
    background-color: var(--color-bg);
}

.nav-item-active {
    background-color: var(--color-gold-soft);
    color: var(--color-gold);
    -unity-font-definition: url("../../Fonts/IBMPlexSans-Bold.ttf");
}

.content-area {
    flex-grow: 1;
}

.page {
    flex-grow: 1;
    padding: 24px 28px;
}

.page-header {
    min-height: 60px;
    margin-bottom: 24px;
}

.page-title {
    font-size: 22px;
    -unity-font-definition: url("../../Fonts/Spectral-Bold.ttf");
    color: var(--color-ink-900);
}

.page-subtitle {
    font-size: 13px;
    color: var(--color-ink-400);
    margin-top: 6px;
}

.kpi-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.kpi-card {
    flex-grow: 1;
    flex-basis: 190px;
    min-width: 190px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
    padding: 14px 16px 18px 16px;
    margin-right: 12px;
    margin-bottom: 12px;
}

/* UI Toolkit's USS does not support the structural pseudo-class :last-child (web-CSS only) —
   confirmed by a real "Unknown pseudo class" warning, not assumed. A small unused trailing
   margin after the last card is harmless, so every card just keeps the same margin-right. */

.kpi-label {
    font-size: 12px;
    color: var(--color-ink-600);
    margin-bottom: 6px;
}

.kpi-value {
    font-size: 22px;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Bold.ttf");
    color: var(--color-ink-900);
    margin-bottom: 4px;
}

.kpi-context {
    font-size: 11px;
    color: var(--color-ink-400);
    margin-top: 10px;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.card {
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
    padding: 16px 18px;
}

.card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 24px;
    margin-bottom: 20px;
}

.card-title {
    font-size: 15px;
    -unity-font-definition: url("../../Fonts/Spectral-Bold.ttf");
    color: var(--color-ink-900);
}

/* An explanatory line under a card's own title (not to be confused with .page-subtitle, which
   sits tight under the big page title and is deliberately closer — reusing .page-subtitle here
   read as "too close to the title" once real text metrics were involved, see ADR-116). */
.card-caption {
    font-size: 12px;
    color: var(--color-ink-400);
    margin-top: 4px;
    margin-bottom: 14px;
}

.badge {
    font-size: 11px;
    padding: 2px 8px;
    background-color: var(--color-gold-soft);
    color: var(--color-gold);
    border-radius: 20px;
}

.empty-state {
    font-size: 13px;
    color: var(--color-ink-400);
}

.list {
    flex-direction: column;
}

.verification-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.verification-row-label {
    font-size: 13px;
    color: var(--color-ink-900);
    flex-grow: 1;
}

.verification-row-date {
    font-size: 11px;
    color: var(--color-ink-400);
    margin-top: 2px;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.verification-row-amount {
    font-size: 13px;
    color: var(--color-ink-900);
    -unity-text-align: middle-right;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.accounts-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.primary-button {
    background-color: var(--color-accent);
    color: #FFFFFF;
    border-width: 0;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

.secondary-button {
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-ink-600);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

.danger-button {
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-danger);
    border-width: 1px;
    border-color: var(--color-danger);
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

.form-card {
    margin-bottom: 16px;
}

.form-row {
    margin-bottom: 30px;
}

.form-label {
    font-size: 12px;
    color: var(--color-ink-600);
    margin-bottom: 4px;
}

.form-field {
    max-width: 360px;
}

.form-error {
    font-size: 12px;
    color: var(--color-danger);
    margin-bottom: 8px;
}

.form-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.form-actions > Button {
    margin-left: 8px;
}

.account-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.account-row:hover {
    background-color: var(--color-bg);
}

.account-row-name {
    font-size: 13px;
    color: var(--color-ink-900);
}

.account-row-meta {
    font-size: 11px;
    color: var(--color-ink-400);
    margin-top: 2px;
}

.account-row-balance {
    font-size: 13px;
    color: var(--color-ink-900);
    -unity-text-align: middle-right;
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.account-row-archived {
    opacity: 0.55;
}

.filter-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.filter-row > .form-label {
    margin-bottom: 0;
    margin-right: 8px;
}

.filter-row > .form-field {
    width: 220px;
}

.form-readonly-value {
    font-size: 13px;
    color: var(--color-ink-600);
}

.form-row-inline {
    flex-direction: row;
    align-items: center;
}

.field-suggested > .unity-base-field__input {
    background-color: var(--color-gold-soft);
}

.transactions-table {
    flex-grow: 1;
    min-height: 220px;
    max-height: 400px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    -unity-font-style: normal;
    color: var(--color-ink-900);
    font-size: 13px;
}

.amount-negative {
    color: var(--color-danger);
}

/* Table date cells have no other dedicated class (unlike amount cells, which already reuse
   .account-row-balance) — applied directly in C# wherever a MultiColumnListView builds a date
   column. */
.cell-mono {
    -unity-font-definition: url("../../Fonts/IBMPlexMono-Regular.ttf");
}

.chart {
    height: 200px;
    margin-bottom: 4px;
}
