*.apk
*.aab
*.unitypackage
*.app
*.exe

# Crashlytics generated file
crashlytics-build.properties

# Local data
*.db
*.db-shm
*.db-wal
!/data/seed/*.db

# Visual Studio / Rider / VS Code cache
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vscode/

# OS generated
.DS_Store
Thumbs.db

# Secrets / local config never committed
*.env.local
